    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "jspdf": "4.2.1",
    "konva": "10.9.1",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@esbuild/win32-x64": "^0.28.2",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "6.0.10",
    "playwright-core": "^1.64.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7",
    "vue-tsc": "^3.3.14"
  }
}
